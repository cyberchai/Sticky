{
  "name": "sticky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Text raw footage over iMessage, get back a trend-informed Reel.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
