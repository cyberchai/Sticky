    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.1",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
