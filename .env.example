# --- Sticky processor (names only; never commit values) ---
PORT=8787

# Linq (same account as Asaply; Sticky owns one number)
LINQ_API_KEY=
LINQ_API_BASE=https://api.linqapp.com/api/partner/v3
LINQ_MEDIA_HOSTS=cdn.linqapp.com
STICKY_LINE=+14044471637

# Temp GCP project (NEVER the Asaply project / billing account)
STICKY_GCP_PROJECT=
STICKY_VERTEX_LOCATION=global
# Set GEMINI_API_KEY instead of Vertex ADC if the event model is AI Studio only
GEMINI_API_KEY=
STICKY_VIDEO_MODEL_ID=
STICKY_FALLBACK_MODEL_ID=gemini-3.8-flash
STICKY_TEXT_MODEL_ID=gemini-3.5-flash-lite
STICKY_VIDEO_FPS=4

# Storage: a temp-project bucket; empty = local disk under STICKY_WORK_DIR (dev only)
STICKY_BUCKET=
STICKY_WORK_DIR=.data

# Database: DATABASE_URL (local Postgres) or the Cloud SQL connector vars
DATABASE_URL=postgres://localhost:5432/sticky
CLOUD_SQL_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Ingress auth
STICKY_PUSH_TOKEN=
STICKY_FORWARD_SECRET=
STICKY_ADMIN_TOKEN=
STICKY_PUBLIC_BASE_URL=

# Behaviour switches (demo/test)
STICKY_COLLECT_MS=5000
STICKY_ECHO=0
STICKY_FORCE_LINK=0
STICKY_TRENDS_FETCH=on
STICKY_TODAY=
